# PostgreSQL (async-драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/booking

# Redis — broker и result backend для TaskIQ
REDIS_URL=redis://127.0.0.1:6379/0

# Поведение задачи подтверждения
CONFIRM_FAILURE_RATE=0.15
CONFIRM_MAX_RETRIES=5
CONFIRM_RETRY_DELAY=1.0

# Rate limiting на POST /bookings (fixed window)
RATE_LIMIT_TIMES=10
RATE_LIMIT_WINDOW_SECONDS=60

# Логирование
LOG_LEVEL=INFO
